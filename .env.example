# CineBox Server Configuration
PORT=4500

# Optional: Free API key from https://www.themoviedb.org/settings/api
# You can also set or update this directly inside the CineBox Settings UI.
TMDB_API_KEY=

# Optional: Absolute or relative path to your local movies folder
# Defaults to ./media inside the project directory
MEDIA_DIR=./media

# Recommended on Vercel / production: HMAC-SHA256 secret for admin session tokens
SESSION_SECRET=

# Supabase Postgres persistence (server-side service role only — never expose service_role in browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
